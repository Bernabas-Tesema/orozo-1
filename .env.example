NODE_ENV=production
PORT=3000

# Public URL of this portal (used in emails / redirects when set)
APP_URL="https://yourdomain.com"

# Optional Node-only: Django URL for /django-api proxy.
# Preferred cPanel deploy is Django-only (npm run build:web → backend/frontend_dist).
DJANGO_API_URL="https://yourdomain.com"

# Platform sign-in. The email must already exist in the database.
PLATFORM_ADMIN_EMAIL="admin.dawit@elip.et"
PLATFORM_ADMIN_PASSWORD=""

HASAB_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="ORZO <noreply@yourdomain.com>"

GEMINI_API_KEY=""

LIVEKIT_URL="wss://orozo-translation-8nvelq7r.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_TOKEN_TTL_SECONDS="1800"

# Optional: portal can also use MySQL/Postgres. Leave blank to use built-in records.
DB_ENGINE=mysql
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="3306"
