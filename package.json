{
  "name": "orzo-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx frontend/server.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build:server": "esbuild frontend/server.ts --bundle --platform=node --format=esm --outfile=app.js --packages=external",
    "build:all": "npm run build:web && npm run build:server",
    "start": "node app.js",
    "start:cpanel": "node app.js",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('app.js',{force:true}); require('fs').rmSync('frontend/dist',{recursive:true,force:true}); require('fs').rmSync('backend/frontend_dist',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
