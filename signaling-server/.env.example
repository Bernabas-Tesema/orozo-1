# =====================================================================
# ORZO SIGNALING SERVER  ->  cPanel "Setup Node.js App"
# Pure in-memory WebSocket relay for WebRTC (no DB / Redis).
# =====================================================================

# cPanel injects PORT automatically for Node apps. Local default is 3001.
PORT=3001

# Soft cap for peers in one call room (client + interpreter + optional supervisor).
MAX_PER_ROOM=8

# Optional: restrict browser Origins that may open WebSockets.
# Leave empty to allow all (fine for initial bring-up).
# Production recommendation (include www if you use it):
ALLOWED_ORIGINS=https://orzo.et,https://www.orzo.et
